# Las dependencias no ejecutan scripts de instalación (preinstall, install, postinstall).
# Ninguna los necesita: esbuild, lmdb, msgpackr-extract y @parcel/watcher usan los binarios
# precompilados que llegan como dependencias opcionales, y ng build, ng test y ng serve
# funcionan sin ellos. Los scripts del propio package.json (npm start, npm test, npm run api)
# se siguen ejecutando porque se piden de forma explícita.
ignore-scripts=true
